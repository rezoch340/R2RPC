# ---- macOS 垃圾文件 ----
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ---- JetBrains (IDEA / WebStorm 等) ----
.idea/
*.iml
*.iws
*.ipr

# ---- VS Code(仅忽略个人设置)----
.vscode/*
!.vscode/extensions.json

# ---- Node / 构建产物 ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
performance-results/
.gradle/
.kotlin/
!backend/pnpm-workspace.yaml
!frontend/pnpm-workspace.yaml
!sdk/javascript/pnpm-workspace.yaml

# ---- 日志 ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ---- 环境变量 / 本地密钥 ----
.env
.env.*
!.env.example
local.properties

# ---- 本地运行配置(含密钥),只跟踪 example ----
config.yaml
!config.example.yaml
deploy/compose.production.yaml
deploy/admin-initial-password.txt

# Claude Code 本地状态 / worktree
.claude/
