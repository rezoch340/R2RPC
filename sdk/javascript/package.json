{
  "name": "@rer0rpc/javascript-sdk",
  "version": "0.1.0",
  "description": "RER0RPC JavaScript/TypeScript device and caller SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run && tsc -p tsconfig.json && tsc -p tsconfig.examples.json"
  },
  "keywords": [
    "rer0rpc",
    "rpc",
    "websocket",
    "device"
  ],
  "license": "UNLICENSED",
  "sideEffects": false,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "isomorphic-ws": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
