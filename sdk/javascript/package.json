{
  "name": "@r2rpc/javascript-sdk",
  "version": "0.1.0",
  "description": "R2RPC JavaScript/TypeScript device and caller SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run && tsc -p tsconfig.json && tsc -p tsconfig.examples.json"
  },
  "keywords": [
    "r2rpc",
    "rpc",
    "websocket",
    "device"
  ],
  "license": "UNLICENSED",
  "author": "R2RPC Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezoch340/R2RPC.git",
    "directory": "sdk/javascript"
  },
  "homepage": "https://github.com/rezoch340/R2RPC/tree/main/sdk/javascript#readme",
  "bugs": {
    "url": "https://github.com/rezoch340/R2RPC/issues"
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "isomorphic-ws": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
